{"t":{"$date":"2026-09-09T11:29:08.690Z"},"s":"I","c":"MONGOSH","id":1000000007,"ctx":"repl","msg":"Evaluating input","attr":{"input":"db = db.getSiblingDB('aulaIdx');\ndb.dropDatabase();\n\nconst cidades = [\"Brasília\",\"São Paulo\",\"Rio de Janeiro\",\"Curitiba\",\"Recife\",\"Salvador\",\"Porto Alegre\",\"Belém\"];\nconst cursos  = [\"Data Science\",\"Engenharia de Dados\",\"Machine Learning\",\"Redes\",\"Sistemas\"];\n\n// carga: 200.000 documentos, SEM indice nenhum alem do _id_\nlet t0 = Date.now();\nfor (let lote = 0; lote < 40; lote++) {\n  const docs = [];\n  for (let i = 0; i < 5000; i++) {\n    const n = lote * 5000 + i;\n    docs.push({\n      matricula: n,\n      nome: \"Aluno \" + n,\n      cidade: cidades[n % 8],\n      curso: cursos[n % 5],\n      idade: 18 + (n % 30),\n      nota: Math.round((n % 101) / 10 * 10) / 10,\n      ativo: n % 2 === 0\n    });\n  }\n  db.alunos.insertMany(docs, { ordered: false });\n}\nconst tCargaSemIndice = Date.now() - t0;\n\nprint(\"docs=\" + db.alunos.countDocuments());\nprint(\"carga_sem_indice_ms=\" + tCargaSemIndice);\n\nfunction med(q, sort) {\n  let c = db.alunos.find(q);\n  if (sort) c = c.sort(sort);\n  const e = c.explain(\"executionStats\").executionStats;\n  return {\n    stage: JSON.stringify(e.executionStages).match(/\"stage\":\"[A-Z_]+\"/g).join(\" > \"),\n    nReturned: e.nReturned,\n    keys: e.totalKeysExamined,\n    docs: e.totalDocsExamined,\n    ms: e.executionTimeMillis\n  };\n}\n\nprint(\"--- SEM INDICE: cidade=Curitiba ---\");\nprintjson(med({ cidade: \"Curitiba\" }));\nprint(\"--- SEM INDICE: cidade=Curitiba AND idade>=40 ---\");\nprintjson(med({ cidade: \"Curitiba\", idade: { $gte: 40 } }));\n\nlet t1 = Date.now();\ndb.alunos.createIndex({ cidade: 1 });\nprint(\"build_indice_cidade_ms=\" + (Date.now() - t1));\n\nprint(\"--- COM INDICE cidade_1: cidade=Curitiba ---\");\nprintjson(med({ cidade: \"Curitiba\" }));\nprint(\"--- COM INDICE cidade_1: cidade=Curitiba AND idade>=40 ---\");\nprintjson(med({ cidade: \"Curitiba\", idade: { $gte: 40 } }));\n\ndb.alunos.createIndex({ cidade: 1, idade: 1 });\nprint(\"--- COM COMPOSTO cidade_1_idade_1: cidade=Curitiba AND idade>=40 ---\");\nprintjson(med({ cidade: \"Curitiba\", idade: { $gte: 40 } }));\nprint(\"--- PREFIXO A ESQUERDA: so idade>=40 (composto NAO serve) ---\");\nprintjson(med({ idade: { $gte: 40 } }));\n\nprint(\"--- baixa cardinalidade: ativo=true, sem indice ---\");\nprintjson(med({ ativo: true }));\ndb.alunos.createIndex({ ativo: 1 });\nprint(\"--- baixa cardinalidade: ativo=true, COM indice ---\");\nprintjson(med({ ativo: true }));\n\nprintjson(db.alunos.stats().indexSizes);\nprint(\"dataSize=\" + db.alunos.stats().size + \" indexSizeTotal=\" + db.alunos.stats().totalIndexSize);"}}
