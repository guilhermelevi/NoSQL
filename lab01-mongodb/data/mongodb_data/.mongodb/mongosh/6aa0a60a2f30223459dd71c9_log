{"t":{"$date":"2026-09-09T00:19:22.713Z"},"s":"I","c":"MONGOSH","id":1000000007,"ctx":"repl","msg":"Evaluating input","attr":{"input":"const N = 100000, LOTE = 5000;\nconst cidades = [\"Brasilia\",\"Goiania\",\"Sao Paulo\",\"Recife\",\"Porto Alegre\"];\nconst cursos  = [\"Data Science\",\"Engenharia de Dados\",\"Business Intelligence\"];\nfunction lote(i0) {\n  const a = [];\n  for (let i = i0; i < i0 + LOTE; i++) {\n    a.push({ seq: i, nome: \"aluno\" + i, idade: 18 + (i % 40),\n             curso: cursos[i % 3], cidade: cidades[i % 5], nota: (i % 100) / 10 });\n  }\n  return a;\n}\nfunction carregar(col) {\n  const t0 = Date.now();\n  for (let i = 0; i < N; i += LOTE) col.insertMany(lote(i), { ordered: false });\n  return Date.now() - t0;\n}\n\ndb.semIndice.drop(); db.comIndice.drop();\n\n// A) só o _id_\nconst tA = carregar(db.semIndice);\n\n// B) cinco índices secundários criados ANTES da carga\ndb.comIndice.createIndex({ nome: 1 });\ndb.comIndice.createIndex({ idade: 1 });\ndb.comIndice.createIndex({ curso: 1 });\ndb.comIndice.createIndex({ cidade: 1 });\ndb.comIndice.createIndex({ cidade: 1, nota: -1 });\nconst tB = carregar(db.comIndice);\n\nconst sA = db.semIndice.stats(), sB = db.comIndice.stats();\nprint(\"docs                 : \" + N);\nprint(\"insercao SEM indices : \" + tA + \" ms\");\nprint(\"insercao COM 5 indices: \" + tB + \" ms  (\" + (tB/tA).toFixed(2) + \"x)\");\nprint(\"indexSize  sem/com   : \" + sA.totalIndexSize + \" / \" + sB.totalIndexSize + \" bytes\");\nprint(\"storageSize sem/com  : \" + sA.storageSize + \" / \" + sB.storageSize + \" bytes\");\nprint(\"indices em comIndice : \" + Object.keys(sB.indexSizes).join(\", \"));"}}
